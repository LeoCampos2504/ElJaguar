{
  "name": "remis-norte-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api.ts",
    "predev": "npm run prisma:generate",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/api.js",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run prisma:generate",
    "test": "tsx --test test/health.test.ts test/config.test.ts",
    "prisma:validate": "prisma validate --config=./prisma.config.ts",
    "prisma:generate": "prisma generate --config=./prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "^5.12.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
